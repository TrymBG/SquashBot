{
  "name": "discord-squash-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "deploy": "tsx --env-file=.env src/deploy-commands.ts",
    "api": "tsx --env-file-if-exists=.env src/api.ts",
    "web": "npm --prefix web run dev",
    "dev:web": "concurrently -k -n api,web -c blue,magenta \"DATABASE_PATH=seed.db npm run api\" \"npm run web\"",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrymBG/SquashBot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/TrymBG/SquashBot/issues"
  },
  "homepage": "https://github.com/TrymBG/SquashBot#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
